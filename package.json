{
  "name": "runledger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Enterprise auditable agent runtime (minimal viable scaffold)",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "runledger": "./bin/runledger.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./api/*": {
      "import": "./dist/api/*.js",
      "types": "./dist/api/*.d.ts"
    },
    "./auth/*": {
      "import": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./runtime/contracts": {
      "import": "./dist/runtime/contracts/public.js",
      "types": "./dist/runtime/contracts/public.d.ts"
    },
    "./bun-oauth": {
      "import": "./dist/bun-oauth.js",
      "types": "./dist/bun-oauth.d.ts"
    },
    "./providers/*": {
      "import": "./dist/providers/*.js",
      "types": "./dist/providers/*.d.ts"
    },
    "./storage/*": {
      "import": "./dist/storage/*.js",
      "types": "./dist/storage/*.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:linux-peer-credential-helper": "tsx scripts/build-linux-peer-credential-helper.ts",
    "build": "npm run build:linux-peer-credential-helper && tsc -p tsconfig.json",
    "check:current-format": "tsx scripts/check-current-format.ts",
    "check:storage-boundaries": "tsx scripts/check-storage-boundaries.ts",
    "check:runtime-boundaries": "tsx scripts/check-runtime-boundaries.ts",
    "check:contract-consumers": "tsc --noEmit -p tsconfig.contract-consumers.json",
    "check:execution-boundaries": "tsx scripts/check-execution-boundaries.ts",
    "check": "npm run check:current-format && npm run check:storage-boundaries && npm run check:runtime-boundaries && npm run check:contract-consumers && npm run check:execution-boundaries && tsc --noEmit -p tsconfig.json",
    "demo": "tsx examples/run.ts",
    "demo:tui": "bun examples/tui-demo.ts",
    "dev": "tsx watch examples/run.ts",
    "generate-models": "node --experimental-strip-types scripts/generate-models.ts",
    "test": "vitest run && npm run test:tui-native",
    "test:tui-native": "bun test tests/tui/*.bun.test.ts",
    "test:watch": "vitest",
    "cli": "tsx src/cli/cli.ts",
    "cli:debug": "RUNLEDGER_DEBUG=1 tsx src/cli/cli.ts",
    "verify:multi-client-host": "tsx scripts/verify-multi-client-host.ts",
    "verify:managed-process-pty": "tsx scripts/verify-managed-process-pty.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@google/genai": "1.52.0",
    "@mistralai/mistralai": "2.2.6",
    "@opentelemetry/api": "1.9.0",
    "@opentui/core": "0.4.5",
    "@smithy/node-http-handler": "4.7.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "node-pty": "1.1.0",
    "openai": "6.26.0",
    "partial-json": "0.1.7",
    "proper-lockfile": "4.1.2",
    "string-width": "7.2.0",
    "strip-ansi": "7.1.2",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
