{
  "name": "runledger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Enterprise auditable agent runtime (minimal viable scaffold)",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "runledger": "bin/runledger.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./api/*": {
      "import": "./dist/api/*.js",
      "types": "./dist/api/*.d.ts"
    },
    "./auth/*": {
      "import": "./dist/auth/*.js",
      "types": "./dist/auth/*.d.ts"
    },
    "./runtime/contracts": {
      "import": "./dist/runtime/contracts/public.js",
      "types": "./dist/runtime/contracts/public.d.ts"
    },
    "./bun-oauth": {
      "import": "./dist/bun-oauth.js",
      "types": "./dist/bun-oauth.d.ts"
    },
    "./providers/*": {
      "import": "./dist/providers/*.js",
      "types": "./dist/providers/*.d.ts"
    },
    "./storage/*": {
      "import": "./dist/storage/*.js",
      "types": "./dist/storage/*.d.ts"
    },
    "./utils/*": {
      "import": "./dist/utils/*.js",
      "types": "./dist/utils/*.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/native/runledger-syntax-highlighter.node",
    "assets/tree-sitter",
    "README.md"
  ],
  "scripts": {
    "build:linux-peer-credential-helper": "tsx scripts/build-linux-peer-credential-helper.ts",
    "build:syntax-highlighter": "tsx scripts/build-syntax-highlighter.ts",
    "check:syntax-highlighter": "cargo test --locked --manifest-path native/syntax-highlighter/Cargo.toml",
    "build": "npm run build:linux-peer-credential-helper && npm run build:syntax-highlighter && tsc -p tsconfig.json && tsx scripts/generate-host-build-manifest.ts",
    "check:current-format": "tsx scripts/check-current-format.ts",
    "check:storage-boundaries": "tsx scripts/check-storage-boundaries.ts",
    "check:runtime-boundaries": "tsx scripts/check-runtime-boundaries.ts",
    "check:contract-consumers": "tsc --noEmit -p tsconfig.contract-consumers.json",
    "check:execution-boundaries": "tsx scripts/check-execution-boundaries.ts",
    "check:bash-ast-assets": "tsx scripts/check-bash-ast-assets.ts",
    "check:platform-boundaries": "tsx scripts/check-platform-boundaries.ts",
    "check:session-owner-boundaries": "tsx scripts/check-session-owner-boundaries.ts",
    "check": "npm run check:current-format && npm run check:storage-boundaries && npm run check:runtime-boundaries && npm run check:contract-consumers && npm run check:execution-boundaries && npm run check:platform-boundaries && npm run check:tui-boundaries && npm run check:session-owner-boundaries && npm run check:syntax-highlighter && npm run check:bash-ast-assets && tsc --noEmit -p tsconfig.json",
    "demo": "tsx examples/run.ts",
    "demo:tui": "bun examples/tui-demo.ts",
    "benchmark:tui-streaming": "tsx scripts/benchmark-tui-streaming.ts",
    "benchmark:streaming-prefix-stability": "tsx scripts/benchmark-streaming-prefix-stability.ts",
    "benchmark:syntax-highlighter": "tsx scripts/benchmark-syntax-highlighter.ts",
    "dev": "tsx watch examples/run.ts",
    "generate-models": "node --experimental-strip-types scripts/generate-models.ts",
    "test": "vitest run && npm run test:tui-native",
    "test:tui-native": "node scripts/run-tui-bun-tests.mjs",
    "test:watch": "vitest",
    "cli": "npm run build && ./bin/runledger.js",
    "cli:debug": "npm run build && RUNLEDGER_DEBUG=1 ./bin/runledger.js",
    "verify:multi-client-host": "tsx scripts/verify-multi-client-host.ts",
    "verify:managed-process-pty": "tsx scripts/verify-managed-process-pty.ts",
    "verify:host-build-replacement": "tsx scripts/verify-host-build-replacement.ts",
    "verify:runtime-host-audit": "tsx scripts/verify-runtime-host-audit.ts",
    "verify:session-owner-candidate": "tsx scripts/verify-session-owner-candidate.ts",
    "check:tui-boundaries": "tsx scripts/check-tui-boundaries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@google/genai": "1.52.0",
    "@mistralai/mistralai": "2.2.6",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "1.9.0",
    "@opentui/core": "0.4.5",
    "@smithy/node-http-handler": "4.7.3",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "node-fetch": "3.3.2",
    "node-pty": "1.1.0",
    "openai": "6.26.0",
    "partial-json": "0.1.7",
    "proper-lockfile": "4.1.2",
    "string-width": "7.2.0",
    "strip-ansi": "7.1.2",
    "tree-sitter-bash": "0.25.1",
    "typebox": "1.1.38",
    "web-tree-sitter": "0.26.11"
  },
  "optionalDependencies": {
    "@runledger/syntax-highlighter-linux-x64-gnu": "0.0.1",
    "@runledger/syntax-highlighter-linux-arm64-gnu": "0.0.1",
    "@runledger/syntax-highlighter-linux-x64-musl": "0.0.1",
    "@runledger/syntax-highlighter-linux-arm64-musl": "0.0.1",
    "@runledger/syntax-highlighter-darwin-x64": "0.0.1",
    "@runledger/syntax-highlighter-darwin-arm64": "0.0.1",
    "@runledger/syntax-highlighter-win32-x64-msvc": "0.0.1",
    "@runledger/syntax-highlighter-win32-arm64-msvc": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "keywords": [],
  "author": ""
}
