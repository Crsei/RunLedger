{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": [],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"incremental": false,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
	"exclude": ["src/contracts/**", "test/browser-consumer.ts"]
}
